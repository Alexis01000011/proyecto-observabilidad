# ==========================================================================
# .env.example — observabilidad-devops
# Copia este archivo a `.env` y rellena los valores reales. NUNCA commitees `.env`
# (está en .gitignore). Estos valores se interpolan en docker-compose.yml.
# ==========================================================================

# ---- Dominio (Cloudflare + NPM) ----
DOMAIN=notalexispage.online

# ---- Grafana (admin inicial) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambia_esto

# ---- MariaDB ----
MARIADB_ROOT_PASSWORD=cambia_esto_root

# Base de datos / usuario para Django
DJANGO_DB_NAME=djangodb
DJANGO_DB_USER=django
DJANGO_DB_PASSWORD=cambia_esto_django

# Base de datos / usuario para WordPress
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=cambia_esto_wp

# Usuario de monitoreo (mysqld-exporter, permisos mínimos)
EXPORTER_DB_USER=exporter
EXPORTER_DB_PASSWORD=cambia_esto_exporter

# ---- Django ----
DJANGO_SECRET_KEY=cambia_esto_secret
DJANGO_ALLOWED_HOSTS=django.notalexispage.online,localhost,127.0.0.1
# DEBUG: dejar en False en producción (expone trazas/SQL); poner True solo para depurar.
DJANGO_DEBUG=False
# Orígenes HTTPS de confianza para CSRF (el formulario se sirve detrás del proxy).
# Coma-separado. Si se deja vacío, se derivan https://<dominio> de DJANGO_ALLOWED_HOSTS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://django.notalexispage.online

# ---- SMTP / Alertas por correo (Alertmanager) ----
# OJO: el App Password de Gmail NO va en este archivo: se guarda en
# secrets/smtp_password (gitignored) y Alertmanager lo lee por smtp_auth_password_file.
# El remitente/usuario van directos en alertmanager/alertmanager.yml (no son secretos).
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=alexiskyc@gmail.com
SMTP_USER=alexiskyc@gmail.com
ALERT_EMAIL_TO=destinatario@ejemplo.com   # destinatario DISTINTO al remitente (definir antes de M5)
